# Copy to the server as /opt/ffl/.env and fill in real values.
# Used by systemd EnvironmentFile (see deploy/ffl-backend.service).

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081

# PostgreSQL on the same ECS as poker
DB_URL=jdbc:postgresql://127.0.0.1:5432/hnair_ffl
DB_USERNAME=ffl
DB_PASSWORD=change_me_to_a_strong_password
